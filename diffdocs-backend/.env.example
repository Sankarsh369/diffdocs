# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0
GEMINI_API_KEY=your-gemini-api-key
WEBHOOK_SECRET=a-long-random-string-used-to-sign-github-webhook-payloads

# Comma-separated list of origins allowed to call this API (your deployed frontend URL).
# Use "*" only for local development.
CORS_ORIGINS=http://localhost:3000

# --- Real GitHub App integration (powers /webhook/github-app) ---
# See diffdocs-backend/README.md for how to register the App and get these values.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=another-long-random-string-set-on-the-github-app-itself

# --- Sign in with GitHub (powers /auth/github/*, /api/me) ---
# A separate, minimal GitHub OAuth App (github.com/settings/applications/new) —
# only ever used to prove who the human is, not to access repos.
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret
# Random string used to sign session JWTs. Generate with `openssl rand -hex 32`.
SESSION_SECRET=a-long-random-string-used-to-sign-session-tokens
# This backend's own public URL (used to build the OAuth redirect_uri) and
# the deployed frontend's URL (where we send the user back to after login).
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
