# Copy this file to .env.local for local development and to your hosting
# provider's environment variables for production. Never commit .env.local.

# Base URL of the deployed diffdocs-backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public slug of your registered GitHub App (from its settings page URL),
# used to build the "Install GitHub Application" link. Leave unset to
# disable that button until you've registered the App — see
# diffdocs-backend/README.md.
NEXT_PUBLIC_GITHUB_APP_SLUG=
